# System Environment Configuration
# All configurations default to zero-cost local execution

PROJECT_NAME="Trust-Aware SOAR"
ENV="development"
DEBUG=True
API_V1_PREFIX="/api"

# Security & Authentication
SECRET_KEY="trust-aware-soar-development-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (Defaults to SQLite for instant zero-install local run)
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/trust_soar
DATABASE_URL="sqlite:///./trust_soar.db"

# Network SDN Adapter Mode: "MOCK" or "RYU"
NETWORK_ADAPTER_MODE="MOCK"
RYU_ENDPOINT="http://localhost:8080"
MININET_SUBNET="10.0.0.0/24"

# Autonomy Thresholds
AUTONOMY_THRESHOLD_HIGH=0.85
AUTONOMY_THRESHOLD_LOW=0.55

# Monitoring
PROMETHEUS_METRICS_ENABLED=True
PROMETHEUS_PORT=9090

